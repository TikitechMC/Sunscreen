{
  "schemaVersion": 1,
  "id": "sunscreen",
  "version": "${version}",
  "name": "Sunscreen",
  "description": "Create UIs like never seen before, all from within the game!",
  "authors": [
    "Combimagnetron"
  ],
  "contact": {
    "homepage": "https://combimagnetron.me"
  },
  "license": "MIT",
  "accessWidener": "sunscreen.accesswidener",
