    ],
    "main": [
      "me.combimagnetron.sunscreen.fabric.SunscreenFabricMod"
    ]
  },
  "mixins": [
    {
      "config": "sunscreen.mixins.json",
      "environment": "server"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.3",
    "minecraft": ">=${minecraftVersion}",
    "fabric-api": ">=${fabricModules}"
